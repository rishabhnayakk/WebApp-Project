{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://dinkalwebapp.onrender.com/api/:match*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/track",
      "destination": "/track.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/wishlist",
      "destination": "/wishlist.html"
    }
  ]
}
